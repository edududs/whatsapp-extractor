# Pairing database: a SQLite file or postgres:// DSN. Keep its credentials private.
EXTRACTOR_DATABASE=session.db

# Optional service account override. Remove this line to use the TOML default.
# An empty value selects no default account and overrides the TOML account.
EXTRACTOR_ACCOUNT=

# TOML file used for both settings and CLI edits; --config takes precedence.
EXTRACTOR_CONFIG=extractor.toml
