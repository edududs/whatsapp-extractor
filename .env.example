# Session storage: a SQLite path or postgres:// DSN used by both neonize and the extractor.
# This database contains pairing credentials and saved messages. Keep it private.
EXTRACTOR_DATABASE=session.db

# A matching chat OR sender is accepted. Empty lists accept every message.
# Chats accept JIDs or the other participant's phone number in direct conversations.
# Senders accept JIDs, phone numbers or LIDs.
EXTRACTOR_WATCHLIST__CHATS=["120363000000000000@g.us"]
EXTRACTOR_WATCHLIST__SENDERS=["5561999999999"]

# Choose persistence: memory, jsonl or sql. The path below applies only to jsonl.
EXTRACTOR_STORE=sql
EXTRACTOR_JSONL_PATH=messages.jsonl

# Terminal output: panel, json or log. Install the rich extra for panel and json.
EXTRACTOR_VIEW=panel

# Maximum queued messages. New arrivals beyond this limit are discarded and logged.
EXTRACTOR_BUFFER_SIZE=10000
